# ============================================
# Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# Site URL (used for SEO, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://aarvana.com

# Google Maps API Key (for location maps)
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Form submission endpoint (e.g., Formspree, custom API)
# NEXT_PUBLIC_FORM_ENDPOINT=

# Google Analytics / Tag Manager
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=

# WhatsApp API (if using click-to-chat API)
# NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
